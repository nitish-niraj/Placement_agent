# PIA environment template — copy to infrastructure/.env and fill secrets.
# NEVER commit the real .env (SEC-001). gitleaks + CI guard against leaks.

# --- Core (master §22) ---
APP_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
WHATSAPP_PROVIDER=evolution

# --- Postgres (compose provides container-internal URLs automatically) ---
POSTGRES_USER=pia
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pia

# --- Dashboard auth (Q3 default: single bearer token) ---
DASHBOARD_TOKEN=change-me
REQUIRE_AUTH=true

# --- MinIO ---
MINIO_ROOT_USER=piaminio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=pia-media

# --- LLM: NVIDIA NIM hosted API (DEC-006; DEC-010 model swap 2026-09-13) ---
LLM_PROVIDER=openai_compatible
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
AGENT_MAX_STEPS=6
REVIEWER_ENABLED=true

# --- Notifications: Telegram bot (DEC-002) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ask PIA over Telegram (long-polling bot; answers only TELEGRAM_CHAT_ID)
TELEGRAM_ASK_ENABLED=true
DIGEST_HOUR=20
DIGEST_MINUTE=30
NOTIFY_SEND_ATTEMPTS=3

# --- Notification policy ---
NOTIFY_CRITICAL_IMMEDIATELY=true
NOTIFY_MEDIUM_IN_DIGEST=true
# Notification pipeline switches (all default-on except debug)
NOTIFICATION_ENABLED=true
DIGEST_ENABLED=true
ATTACHMENT_ANALYSIS_ENABLED=true
ATTACHMENT_RETRY_ENABLED=true
TEST_MESSAGE_FILTER_ENABLED=true
DEBUG_NOTIFICATIONS_ENABLED=false
# Ops channel for worker internals (DLQ summaries). Empty = same chat as the
# student, redacted to one plain-language line (traces never leave the logs).
ADMIN_TELEGRAM_CHAT_ID=

# --- Matching thresholds (TRD §6, ADR-009) ---
# Tuned on the P6 fixture corpus (tests/fixtures/eligibility_corpus.py) — NOT invented.
# Corpus separation: "me" >= 0.957, "could_be_me" >= 0.917, "not_me" <= 0.870.
# Rationale + accepted error trade-off: docs/07_P6_Threshold_Evaluation.md
FUZZY_MATCH_THRESHOLD=0.95
AMBIGUOUS_MATCH_THRESHOLD=0.90

# --- Media & retention (defaults per 02_TRD §11, Q7) ---
MEDIA_MAX_SIZE_MB=25
RAW_MESSAGE_RETENTION_DAYS=90
DOCUMENT_RETENTION_DAYS=365

# --- P9 dedup windows + threshold (measured on the live corpus — docs/08) ---
DEDUP_NEAR_WINDOW_HOURS=48
DEDUP_EXACT_REMINDER_DAYS=7
DEDUP_NEAR_THRESHOLD=0.72

# --- Evolution API connector (P1, F-004) ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=            # generate: python -c "import secrets;print(secrets.token_hex(24))"
EVOLUTION_WEBHOOK_SECRET=     # shared secret the connector sends as X-PIA-Token on webhooks

# --- Safety: irreversible actions (SEC-005). Must stay false in MVP. ---
ACTION_AUTOMATION_ENABLED=false

# --- SEC-002: encryption of sensitive profile fields at rest ---
# 32-byte urlsafe-base64 key. Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PIA_ENCRYPTION_KEY=

# --- Teams listener (DEC-008 amendment): login popup credentials ---
TEAMS_EMAIL=
TEAMS_PASSWORD=

# --- Summary fallback ladder (DEC-010, 2026-09-13) ---
# Chain order: NIM (structured) -> OpenRouter -> Groq -> raw transcript.
# Each rung tags the source in the Telegram message. All keys FREE-tier;
# if a provider 402s/429s, the next rung takes over automatically.

# Rung 2 — OpenRouter (free inclusionai/ling-3.0-flash-vl; reasoning model,
# needs generous max_tokens — handled in code).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rung 3 — Groq (free openai/gpt-oss-120b: 1K req + 200K tokens/day).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- P14.1 form submit executor (ADR-012, per-capability SEC-005) ---
FORM_AUTOMATION_ENABLED=false
FORM_SUBMIT_DRY_RUN=true
STAGE3_EXECUTORS_ENABLED=false
# ADR-014 Stage 4: reactive judgment for hard-to-classify messages
STAGE4_REACTIVE_ENABLED=false
STAGE4_CONFIDENCE_THRESHOLD=0.7
STAGE4_ESCALATION_CAP=3

# --- Round 2 throughput: queues each worker process drains, in order ---
# bulk worker: default,maintenance — realtime worker: realtime,maintenance
WORKER_QUEUES=default,maintenance
# Per-group burst shaping: past this many messages per window, jobs are
# scheduled with growing delays (never dropped)
WEBHOOK_BURST_PER_GROUP=120
WEBHOOK_BURST_WINDOW_SECONDS=300
