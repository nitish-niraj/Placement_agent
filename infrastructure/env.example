# PIA environment template — copy to infrastructure/.env and fill secrets.
# NEVER commit the real .env (SEC-001). gitleaks + CI guard against leaks.

# --- Core (master §22) ---
APP_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
WHATSAPP_PROVIDER=evolution

# --- Postgres (compose provides container-internal URLs automatically) ---
POSTGRES_USER=pia
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pia

# --- Dashboard auth (Q3 default: single bearer token) ---
DASHBOARD_TOKEN=change-me
REQUIRE_AUTH=true

# --- MinIO ---
MINIO_ROOT_USER=piaminio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=pia-media

# --- LLM: NVIDIA NIM hosted API (DEC-006, owner decision 2026-09-05) ---
LLM_PROVIDER=openai_compatible
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL=mistralai/mistral-nemotron
LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# --- Notifications: Telegram bot (DEC-002) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_HOUR=20
DIGEST_MINUTE=30
NOTIFY_SEND_ATTEMPTS=3

# --- Notification policy ---
NOTIFY_CRITICAL_IMMEDIATELY=true
NOTIFY_MEDIUM_IN_DIGEST=true

# --- Matching thresholds (TRD §6, ADR-009) ---
# Tuned on the P6 fixture corpus (tests/fixtures/eligibility_corpus.py) — NOT invented.
# Corpus separation: "me" >= 0.957, "could_be_me" >= 0.917, "not_me" <= 0.870.
# Rationale + accepted error trade-off: docs/07_P6_Threshold_Evaluation.md
FUZZY_MATCH_THRESHOLD=0.95
AMBIGUOUS_MATCH_THRESHOLD=0.90

# --- Media & retention (defaults per 02_TRD §11, Q7) ---
MEDIA_MAX_SIZE_MB=25
RAW_MESSAGE_RETENTION_DAYS=90
DOCUMENT_RETENTION_DAYS=365

# --- P9 dedup windows + threshold (measured on the live corpus — docs/08) ---
DEDUP_NEAR_WINDOW_HOURS=48
DEDUP_EXACT_REMINDER_DAYS=7
DEDUP_NEAR_THRESHOLD=0.72

# --- Evolution API connector (P1, F-004) ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=            # generate: python -c "import secrets;print(secrets.token_hex(24))"
EVOLUTION_WEBHOOK_SECRET=     # shared secret the connector sends as X-PIA-Token on webhooks

# --- Safety: irreversible actions (SEC-005). Must stay false in MVP. ---
ACTION_AUTOMATION_ENABLED=false

# --- SEC-002: encryption of sensitive profile fields at rest ---
# 32-byte urlsafe-base64 key. Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PIA_ENCRYPTION_KEY=
